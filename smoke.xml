<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.reports.AllureTestNgListener"/>
        <listener class-name="com.testng.DisableRetryTransformer"/>
    </listeners>
    <test name="Smoke Tests">
        <parameter name="env" value="dev"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="platform" value="local"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.testsuites.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                    <include name="testLoginPageIsLoaded"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1">
    <test name="Login Regression Tests">
        <parameter name="env" value="qa"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="platform" value="local"/>
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.testsuites.LoginTest">
                <methods>
                    <include name="testInvalidCredentialsShowError"/>
                    <include name="testEmptyCredentialsShowError"/>
                    <include name="testEmptyUsernameShowsError"/>
                    <include name="testEmptyPasswordShowsError"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

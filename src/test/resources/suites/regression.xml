<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.reports.AllureTestNgListener"/>
        <listener class-name="com.testng.DisableRetryTransformer"/>
    </listeners>
    <test name="Login Regression Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.testsuites.LoginTest"/>
        </classes>
    </test>
</suite>
